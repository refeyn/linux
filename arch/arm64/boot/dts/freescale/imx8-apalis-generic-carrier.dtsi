// Common carrier functions

/ {
    reg_usb_host_vbus: regulator-usb-host-vbus {
        regulator-name = "VCC_USBH(2|4)";
    };
};

/* Apalis UART1 */
&lpuart1 {
	status = "okay";
};

/* Apalis USBH2, Apalis USBH3 and on-module Wi-Fi via on-module HSIC Hub */
&usbh1 {
	vbus-supply = <&reg_usb_host_vbus>;
	status = "okay";
};

/* Apalis USBO1 */
&usbotg1 {
	status = "okay";
};

/* Apalis I2C1 */
&i2c2 {
	status = "okay";

	carrier_eeprom: carrier-eeprom@50 {
        compatible = "atmel,24c256";
        reg = <0x50>;
	};
};

&gpio_fan {
    status = "disabled";
};

&reg_pcie_switch {
    /delete-property/ pinctrl-0;
};

// Random image and audio processing

&asrc0 {
	status = "okay";
};


/ {
	aliases {
		rtc0 = &rtc_i2c;
		rtc1 = &rtc;
	};

	reg_usb_host_vbus: regulator-usb-host-vbus {
		regulator-name = "VCC USBH2(ABCD) / USBH(3|4)";
	};
};

